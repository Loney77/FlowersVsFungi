classDiagram
    class PlantingService {
        <<interface>>
        +place(pos, plant_type) bool
    }
    class PlantingProxy {
        -game: Game
        -service: PlantingService
        -COSTS: dict
        +place(pos, plant_type) bool
    }
    class GardenPlantingService {
        -game: Game
        +place(pos, plant_type) bool
    }
    class Game {
        +game_over: bool
        +sun: int
        +grid: list
        +plant_group: EntityGroup
        +plant_factory: GardenPlantFactory
        +try_plant_flower(pos)
    }
    class GardenPlantFactory {
        +create_attacker(row, col)
        +create_resource_generator(row, col)
    }
    class EntityGroup {
        +add(component)
    }
    PlantingProxy ..|> PlantingService
    GardenPlantingService ..|> PlantingService
    Game --> PlantingProxy : принимает запрос посадки
    PlantingProxy --> GardenPlantingService : проверяет доступ и делегирует
    GardenPlantingService --> GardenPlantFactory : создаёт цветок
    GardenPlantingService --> EntityGroup : добавляет цветок
    GardenPlantingService --> Game : изменяет игровое поле
